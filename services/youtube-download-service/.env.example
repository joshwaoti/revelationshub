AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
YOUTUBE_SERVICE_TOKEN=

# Comma- or newline-separated authenticated residential/static proxy URLs.
# These routes are used only by yt-dlp; S3 traffic remains direct.
YOUTUBE_PROXY_URLS=
ALLOW_DIRECT_YOUTUBE_FALLBACK=true
MAX_PROXY_ATTEMPTS=4

ALLOWED_ORIGINS=https://app.zitrionhub.xyz
PUBLIC_INFO_ENDPOINT=false
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOAD_SECONDS=10800
MAX_DOWNLOAD_BYTES=8589934592
MAX_VIDEO_HEIGHT=1080
